<li class="card recipe-card" id="<%= dom_id(recipe, :card) %>">
  <%= link_to recipe, class: "recipe-card__link" do %>
    <div class="recipe-card__photo recipe-card__photo--empty" aria-hidden="true"><%= recipe.title.first.upcase %></div>
    <h2 class="recipe-card__title"><%= recipe.title %></h2>
  <% end %>
  <div class="recipe-card__meta">
    <% if recipe.total_minutes %>
      <span><%= duration(recipe.total_minutes) %></span>
    <% end %>
    <span><%= pluralize(recipe.servings, "serving") %></span>
  </div>
  <% if recipe.tags.any? %>
    <ul class="tag-list">
      <% recipe.tags.each do |tag| %>
        <li><%= link_to tag.name, recipes_path(tag: tag.name), class: "tag" %></li>
      <% end %>
    </ul>
  <% end %>
  <div class="recipe-card__favourite">
    <%= render "recipes/favourite_button", recipe: recipe %>
  </div>
</li>
