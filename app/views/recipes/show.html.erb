<% content_for :title, @recipe.title %>

<article class="recipe">
  <header class="recipe__header">
    <div class="recipe__heading">
      <h1><%= @recipe.title %></h1>
      <%= render "recipes/favourite_button", recipe: @recipe %>
    </div>
    <div class="recipe__actions">
      <%= link_to "Cook mode", recipe_cook_path(@recipe, servings: @servings), class: "button button--primary" %>
      <%= link_to "Edit", edit_recipe_path(@recipe), class: "button" %>
      <%= button_to "Duplicate", recipe_duplicate_path(@recipe), class: "button" %>
      <%= button_to "Delete", @recipe, method: :delete, class: "button button--danger",
            form: { data: { turbo_confirm: "Delete #{@recipe.title}? This can't be undone." } } %>
    </div>
  </header>

  <% if @recipe.photo.attached? %>
    <%= image_tag @recipe.photo.variant(:large), alt: @recipe.title, class: "recipe__photo" %>
  <% end %>

  <% if @recipe.description.present? %>
    <p class="recipe__description"><%= @recipe.description %></p>
  <% end %>

  <dl class="recipe__facts">
    <% if @recipe.prep_minutes %>
      <div><dt>Prep</dt><dd><%= duration(@recipe.prep_minutes) %></dd></div>
    <% end %>
    <% if @recipe.cook_minutes %>
      <div><dt>Cook</dt><dd><%= duration(@recipe.cook_minutes) %></dd></div>
    <% end %>
    <% if @recipe.source_url.present? %>
      <div><dt>From</dt><dd><%= source_link(@recipe) %></dd></div>
    <% end %>
  </dl>

  <% if @recipe.tags.any? %>
    <ul class="tag-list">
      <% @recipe.tags.each do |tag| %>
        <li><%= link_to tag.name, recipes_path(tag: tag.name), class: "tag" %></li>
      <% end %>
    </ul>
  <% end %>

  <div class="recipe__body">
    <section class="recipe__ingredients" aria-labelledby="ingredients-heading"
             data-controller="scale" data-scale-base-value="<%= @recipe.servings %>">
      <h2 id="ingredients-heading">Ingredients</h2>
      <%= form_with url: recipe_path(@recipe), method: :get, class: "servings" do |form| %>
        <%= form.label :servings, "Servings" %>
        <div class="stepper">
          <button type="button" class="stepper__button" data-action="scale#decrement" aria-label="Fewer servings">−</button>
          <%= form.number_field :servings, value: @servings, min: 1, max: 100, class: "servings__input",
                data: { scale_target: "input", action: "input->scale#update" } %>
          <button type="button" class="stepper__button" data-action="scale#increment" aria-label="More servings">+</button>
        </div>
        <noscript><%= form.submit "Scale", class: "button button--small", name: nil %></noscript>
      <% end %>

      <% if @recipe.ingredients.any? %>
        <ul class="ingredients">
          <% @recipe.ingredients.each do |ingredient| %>
            <% if ingredient.heading? %>
              <li class="ingredients__heading"><%= ingredient.name %></li>
              <% next %>
            <% end %>
            <li class="ingredient">
              <%= ingredient_amount(ingredient, @scale) %>
              <span class="ingredient__name"><%= ingredient.name %></span><% if ingredient.note.present? %><span class="ingredient__note">, <%= ingredient.note %></span><% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="muted">No ingredients yet. <%= link_to "Add some", edit_recipe_path(@recipe) %>.</p>
      <% end %>
    </section>

    <section class="recipe__method" aria-labelledby="method-heading">
      <h2 id="method-heading">Method</h2>
      <% if @recipe.steps.any? %>
        <ol class="steps">
          <% @recipe.steps.each do |step| %>
            <li class="step"><%= step.body %></li>
          <% end %>
        </ol>
      <% else %>
        <p class="muted">No steps yet.</p>
      <% end %>
    </section>
  </div>

  <% if @recipe.notes.present? %>
    <section class="recipe__notes" aria-labelledby="notes-heading">
      <h2 id="notes-heading">Notes</h2>
      <%= simple_format @recipe.notes %>
    </section>
  <% end %>

  <%= render "recipes/add_to_plan", recipe: @recipe, servings: @servings %>
</article>
