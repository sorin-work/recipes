<% content_for :title, "Groceries" %>
<% content_for :head do %>
  <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
<% end %>

<div class="page-header">
  <h1>Grocery list</h1>
  <nav class="week-nav" aria-label="Weeks">
    <%= link_to "←", grocery_list_path(week: @week.previous), class: "button button--quiet", aria: { label: "Previous week" } %>
    <span class="week-nav__label"><%= @week.label %></span>
    <%= link_to "→", grocery_list_path(week: @week.next), class: "button button--quiet", aria: { label: "Next week" } %>
  </nav>
</div>

<div class="grocery-actions">
  <%= link_to "Back to the plan", plan_path(week: @week), class: "button button--quiet" %>
  <%= link_to "Plain text", grocery_list_path(week: @week, format: :txt), class: "button button--quiet", data: { turbo: false } %>
  <button type="button" class="button button--quiet" data-controller="print" data-action="print#print">Print</button>
</div>

<% unless @list.empty? %>
  <% left = @list.to_buy.count { |item| !item.checked } %>
  <p class="grocery-summary muted">
    <%= pluralize(left, "item") %> to buy<% if left < @list.to_buy.size %>, <%= @list.to_buy.size - left %> ticked off<% end %>
  </p>
<% end %>

<% if @list.empty? %>
  <div class="empty-state">
    <h2>Nothing to buy yet</h2>
    <p>Plan some meals for this week and their ingredients will show up here, added up and sorted by aisle.</p>
    <p><%= link_to "Open the planner", plan_path(week: @week), class: "button button--primary" %></p>
  </div>
<% else %>
  <div class="grocery-sections">
    <% @list.sections.each do |aisle, items| %>
      <section class="grocery-section" aria-labelledby="aisle-<%= aisle.parameterize %>">
        <h2 id="aisle-<%= aisle.parameterize %>"><%= aisle.capitalize %></h2>
        <ul class="grocery-items">
          <% items.sort_by { |item| item.checked ? 1 : 0 }.each do |item| %>
            <%= render "grocery_lists/item", item: item %>
          <% end %>
        </ul>
      </section>
    <% end %>
  </div>
<% end %>

<section class="grocery-section grocery-extras" aria-labelledby="extras-heading">
  <h2 id="extras-heading">Extras</h2>
  <% if @extras.any? %>
    <ul class="grocery-items">
      <% @extras.each do |extra| %>
        <li class="grocery-item<%= ' is-checked' if extra.checked %>">
          <%= form_with model: extra, url: grocery_extra_path(extra), method: :patch, class: "grocery-item__check",
                data: { controller: "autosubmit", action: "change->autosubmit#submit" } do |form| %>
            <%= hidden_field_tag "grocery_extra[checked]", "0", id: nil %>
            <label class="checkbox">
              <%= check_box_tag "grocery_extra[checked]", "1", extra.checked, id: dom_id(extra, :checked) %>
              <span class="grocery-item__name"><%= extra.name %></span>
            </label>
            <noscript><%= form.submit "Save", class: "button button--small" %></noscript>
          <% end %>
          <%= button_to grocery_extra_path(extra), method: :delete, class: "grocery-item__remove", aria: { label: "Remove #{extra.name}" } do %>
            <span aria-hidden="true">×</span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
  <%= form_with url: grocery_extras_path(week: @week), scope: :grocery_extra, class: "form form--inline grocery-extras__form" do |form| %>
    <%= form.label :name, "Add something else", class: "visually-hidden" %>
    <%= form.text_field :name, placeholder: "Add something else, e.g. coffee", maxlength: 100, required: true %>
    <%= form.submit "Add", class: "button" %>
  <% end %>
</section>

<% if @list.in_pantry.any? %>
  <section class="grocery-section grocery-pantry" aria-labelledby="pantry-heading">
    <h2 id="pantry-heading">Already in your pantry</h2>
    <ul class="grocery-items grocery-items--muted">
      <% @list.in_pantry.each do |item| %>
        <li class="grocery-item">
          <span class="grocery-item__name"><%= item.name %></span>
          <span class="grocery-item__amount muted">
            <%= item.pantry_item.staple? ? "always in stock" : "you have #{item.pantry_item.amount}" %>
          </span>
        </li>
      <% end %>
    </ul>
    <p class="hint"><%= link_to "Edit your pantry", pantry_items_path %></p>
  </section>
<% end %>
