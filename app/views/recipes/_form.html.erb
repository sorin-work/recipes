<%= form_with(model: recipe, class: "form recipe-form") do |form| %>
  <%= error_messages_for recipe %>

  <div class="field">
    <%= form.label :title %>
    <%= form.text_field :title, required: true, maxlength: 150, autofocus: recipe.new_record? %>
  </div>

  <div class="field">
    <%= form.label :description %>
    <%= form.text_area :description, rows: 3, maxlength: 2000 %>
  </div>

  <div class="field-row">
    <div class="field">
      <%= form.label :servings %>
      <%= form.number_field :servings, min: 1, max: 100, required: true %>
    </div>
    <div class="field">
      <%= form.label :prep_minutes, "Prep (minutes)" %>
      <%= form.number_field :prep_minutes, min: 0, max: 2880 %>
    </div>
    <div class="field">
      <%= form.label :cook_minutes, "Cook (minutes)" %>
      <%= form.number_field :cook_minutes, min: 0, max: 2880 %>
    </div>
  </div>

  <div class="field">
    <%= form.label :ingredients_text, "Ingredients" %>
    <p class="hint" id="ingredients-hint">One per line, e.g. <code>200 g plain flour</code> or <code>1 onion, finely chopped</code>.</p>
    <%= form.text_area :ingredients_text, rows: 10, class: "monospace", aria: { describedby: "ingredients-hint" } %>
  </div>

  <div class="field">
    <%= form.label :steps_text, "Method" %>
    <p class="hint" id="steps-hint">One step per line, or separate steps with a blank line.</p>
    <%= form.text_area :steps_text, rows: 10, aria: { describedby: "steps-hint" } %>
  </div>

  <div class="field">
    <%= form.label :tag_list, "Tags" %>
    <p class="hint" id="tags-hint">Separate with commas, e.g. <code>quick, vegetarian, pasta</code>.</p>
    <%= form.text_field :tag_list, aria: { describedby: "tags-hint" }, list: "tag-suggestions" %>
    <datalist id="tag-suggestions">
      <% Current.user.tags.order(:name).each do |tag| %>
        <option value="<%= tag.name %>"></option>
      <% end %>
    </datalist>
  </div>

  <div class="field">
    <%= form.label :source_url, "Source link" %>
    <%= form.url_field :source_url, placeholder: "https://", maxlength: 2000 %>
  </div>

  <div class="field">
    <%= form.label :notes %>
    <p class="hint" id="notes-hint">Tweaks, what to serve it with, what the kids thought.</p>
    <%= form.text_area :notes, rows: 3, maxlength: 5000, aria: { describedby: "notes-hint" } %>
  </div>

  <div class="field">
    <%= form.label :photo %>
    <% if recipe.photo.attached? && recipe.persisted? %>
      <div class="photo-current">
        <%= image_tag recipe.photo, alt: "", class: "photo-current__image" %>
        <label class="checkbox">
          <%= check_box_tag "recipe[remove_photo]", "1", false, id: "recipe_remove_photo" %> Remove this photo
        </label>
      </div>
    <% end %>
    <%= form.file_field :photo, accept: "image/jpeg,image/png,image/webp,image/gif" %>
    <p class="hint">JPEG, PNG, WebP or GIF up to 5 MB.</p>
  </div>

  <div class="form-actions">
    <%= form.submit recipe.new_record? ? "Save recipe" : "Save changes", class: "button button--primary" %>
    <%= link_to "Cancel", recipe.persisted? ? recipe : recipes_path, class: "button button--quiet" %>
  </div>
<% end %>
