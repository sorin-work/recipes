<% content_for :title, "Meal plan" %>
<% content_for :main_class, "main--wide" %>

<div class="page-header">
  <h1>Meal plan</h1>
  <nav class="week-nav" aria-label="Weeks">
    <%= link_to "←", plan_path(week: @week.previous), class: "button button--quiet", aria: { label: "Previous week" } %>
    <span class="week-nav__label"><%= @week.label %></span>
    <%= link_to "→", plan_path(week: @week.next), class: "button button--quiet", aria: { label: "Next week" } %>
    <% unless @week.current? %>
      <%= link_to "This week", plan_path, class: "button button--quiet" %>
    <% end %>
  </nav>
</div>

<div class="planner-actions">
  <%= link_to "Grocery list for this week", grocery_list_path(week: @week), class: "button button--primary" %>
  <%= button_to "Copy last week", copy_previous_week_plan_path(week: @week), class: "button" %>
  <% if @entries.any? %>
    <%= button_to "Clear week", clear_plan_path(week: @week), method: :delete, class: "button button--danger",
          form: { data: { turbo_confirm: "Remove every meal planned for #{@week.label}?" } } %>
  <% end %>
</div>

<div class="planner planner--with-sidebar" data-controller="planner"
     data-planner-create-url-value="<%= meal_plan_entries_path %>"
     data-planner-entry-url-value="<%= meal_plan_entry_path(":id") %>">
  <aside class="planner__sidebar" aria-labelledby="planner-recipes-heading">
    <h2 id="planner-recipes-heading">Recipes</h2>
    <p class="hint">Drag a recipe onto a day.</p>
    <div data-controller="filter">
      <label for="planner-filter" class="visually-hidden">Filter recipes</label>
      <input type="search" id="planner-filter" placeholder="Filter" autocomplete="off"
             data-filter-target="input" data-action="input->filter#filter">
    <ul class="planner__recipes">
      <% @recipes.each do |recipe| %>
        <li class="planner__recipe" draggable="true"
            data-drag-type="recipe" data-drag-id="<%= recipe.id %>"
            data-action="dragstart->planner#dragstart dragend->planner#dragend"
            data-filter-target="item" data-filter-text="<%= recipe.title %>">
          <%= "★ " if recipe.favourite? %><%= recipe.title %>
        </li>
      <% end %>
    </ul>
    <% if @recipes.empty? %>
      <p class="muted">No recipes yet. <%= link_to "Add one", new_recipe_path %>.</p>
    <% end %>
    </div>
  </aside>

  <div class="planner__grid">
    <% @week.days.each do |date| %>
      <section class="planner__day<%= ' is-today' if date == Date.current %>" aria-labelledby="day-<%= date.iso8601 %>">
        <h2 class="planner__day-name" id="day-<%= date.iso8601 %>">
          <%= plan_day_label(date) %>
          <% if date == Date.current %><span class="badge">Today</span><% end %>
        </h2>
        <% MealPlanEntry::MEALS.each do |meal| %>
          <%= render "plans/cell", date: date, meal: meal, entries: @entries.fetch([ date, meal ], []) %>
        <% end %>
      </section>
    <% end %>
  </div>
</div>
