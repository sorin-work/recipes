<% content_for :title, "Account" %>

<div class="page-header">
  <h1>Account</h1>
</div>

<div class="stack">
  <section class="card" aria-labelledby="profile-heading">
    <h2 id="profile-heading">Profile</h2>
    <%= form_with model: @user, url: account_path, method: :patch, class: "form" do |form| %>
      <%= error_messages_for @user %>
      <div class="field">
        <%= form.label :name %>
        <%= form.text_field :name, required: true, maxlength: 80, autocomplete: "name" %>
      </div>
      <div class="field">
        <%= form.label :email_address, "Email" %>
        <%= form.email_field :email_address, required: true, autocomplete: "email" %>
      </div>
      <%= form.submit "Save", class: "button button--primary" %>
    <% end %>
  </section>

  <section class="card" aria-labelledby="password-heading">
    <h2 id="password-heading">Change password</h2>
    <%= form_with model: @user, url: password_change_path, method: :patch, class: "form" do |form| %>
      <div class="field">
        <%= label_tag :current_password, "Current password" %>
        <%= password_field_tag :current_password, nil, required: true, autocomplete: "current-password" %>
      </div>
      <div class="field">
        <%= form.label :password, "New password" %>
        <%= form.password_field :password, required: true, minlength: 8, maxlength: 72, autocomplete: "new-password" %>
      </div>
      <div class="field">
        <%= form.label :password_confirmation, "Repeat new password" %>
        <%= form.password_field :password_confirmation, required: true, maxlength: 72, autocomplete: "new-password" %>
      </div>
      <%= form.submit "Change password", class: "button" %>
    <% end %>
  </section>

  <section class="card" aria-labelledby="tags-heading">
    <h2 id="tags-heading">Tags</h2>
    <p><%= link_to "Rename or delete tags", tags_path %></p>
  </section>

  <section class="card card--danger" aria-labelledby="delete-heading">
    <h2 id="delete-heading">Delete account</h2>
    <p>This deletes your account, every recipe, your meal plans and your pantry. It can't be undone.</p>
    <%= form_with url: account_path, method: :delete, class: "form form--inline",
          data: { turbo_confirm: "Delete your account and everything in it?" } do |form| %>
      <div class="field">
        <%= label_tag :password, "Your password" %>
        <%= password_field_tag :password, nil, required: true, autocomplete: "current-password" %>
      </div>
      <%= form.submit "Delete my account", class: "button button--danger" %>
    <% end %>
  </section>
</div>
