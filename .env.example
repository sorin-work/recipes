# Copy to .env and adjust. docker compose reads .env automatically.

# Host ports (container ports stay the same)
DB_PORT=5442
APP_PORT=4402

# Postgres credentials for the db service
POSTGRES_USER=recipes
POSTGRES_PASSWORD=recipes
POSTGRES_DB=recipes

# Signs session cookies. Generate one with `bin/rails secret` for anything but your laptop.
SECRET_KEY_BASE=local-development-secret-change-me-0123456789abcdef0123456789abcdef

# Host used in links inside emails (password reset).
APP_HOST=localhost

# Create demo@example.com / demo-password with sample data on start.
SEED_DEMO=true

# Set to true when running behind an HTTPS proxy.
FORCE_SSL=false

# Optional SMTP server for password reset emails. Without it, emails are written
# to tmp/mails inside the container.
# SMTP_ADDRESS=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=

# What "today" means on the planner and home page.
TIME_ZONE=UTC
