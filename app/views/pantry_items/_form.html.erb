<%= form_with model: pantry_item, class: "form form--inline" do |form| %>
  <%= error_messages_for pantry_item %>
  <div class="field">
    <%= form.label :name, "Item" %>
    <%= form.text_field :name, required: true, maxlength: 100, placeholder: "e.g. plain flour" %>
  </div>
  <div class="field">
    <%= form.label :amount_text, "Amount (optional)" %>
    <%= form.text_field :amount_text, placeholder: "e.g. 1 kg or 2 cans" %>
  </div>
  <%= form.submit pantry_item.new_record? ? "Add" : "Save", class: "button button--primary" %>
<% end %>
