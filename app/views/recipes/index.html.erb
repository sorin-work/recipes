<% content_for :title, "Recipes" %>

<div class="page-header">
  <h1>Recipes</h1>
  <div class="page-header__actions">
    <%= link_to "New recipe", new_recipe_path, class: "button button--primary" %>
  </div>
</div>

<%= form_with url: recipes_path, method: :get, class: "filters", role: "search",
      data: { controller: "autosubmit", action: "change->autosubmit#submit",
              turbo_frame: "recipe-results", turbo_action: "advance" } do |form| %>
  <div class="filters__search">
    <%= form.label :q, "Search recipes", class: "visually-hidden" %>
    <%= form.search_field :q, value: params[:q], placeholder: "Search by name or ingredient",
          autocomplete: "off", data: { action: "input->autosubmit#submitLater" } %>
  </div>
  <% if @tags.any? %>
    <div class="filters__field">
      <%= form.label :tag, "Tag", class: "visually-hidden" %>
      <%= form.select :tag, options_from_collection_for_select(@tags, :name, :name, params[:tag]),
            include_blank: "All tags" %>
    </div>
  <% end %>
  <label class="checkbox filters__field">
    <%= form.check_box :favourites, { checked: params[:favourites] == "1" }, "1", nil %>
    Favourites only
  </label>
  <div class="filters__field">
    <%= form.label :sort, "Sort by", class: "visually-hidden" %>
    <%= form.select :sort, [ [ "Newest first", "newest" ], [ "A to Z", "title" ], [ "Quickest first", "quickest" ] ],
          selected: @sort %>
  </div>
  <noscript><%= form.submit "Search", class: "button", name: nil %></noscript>
<% end %>

<%= turbo_frame_tag "recipe-results", target: "_top" do %>
  <% if @recipes.any? %>
    <ul class="card-grid">
      <%= render partial: "recipes/card", collection: @recipes, as: :recipe %>
    </ul>
    <%= render "recipes/pagination", page: @page, total: @total %>
  <% elsif params[:q].present? || params[:tag].present? || params[:favourites] == "1" %>
    <div class="empty-state">
      <h2>Nothing matches</h2>
      <p>Try fewer words or <%= link_to "clear the filters", recipes_path, data: { turbo_frame: "_top" } %>.</p>
    </div>
  <% else %>
    <div class="empty-state">
      <h2>No recipes yet</h2>
      <p>Add the dishes you cook most and they'll be here when you plan the week.</p>
    </div>
  <% end %>
<% end %>
