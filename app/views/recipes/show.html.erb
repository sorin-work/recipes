<% content_for :title, @recipe.title %>

<article class="recipe">
  <header class="recipe__header">
    <div class="recipe__heading">
      <h1><%= @recipe.title %></h1>
    </div>
    <div class="recipe__actions">
      <%= link_to "Edit", edit_recipe_path(@recipe), class: "button" %>
      <%= button_to "Delete", @recipe, method: :delete, class: "button button--danger" %>
    </div>
  </header>

  <% if @recipe.description.present? %>
    <p class="recipe__description"><%= @recipe.description %></p>
  <% end %>

  <dl class="recipe__facts">
    <% if @recipe.prep_minutes %>
      <div><dt>Prep</dt><dd><%= duration(@recipe.prep_minutes) %></dd></div>
    <% end %>
    <% if @recipe.cook_minutes %>
      <div><dt>Cook</dt><dd><%= duration(@recipe.cook_minutes) %></dd></div>
    <% end %>
  </dl>

  <div class="recipe__body">
    <section class="recipe__ingredients" aria-labelledby="ingredients-heading">
      <h2 id="ingredients-heading">Ingredients</h2>
      <p class="muted">Serves <%= @recipe.servings %></p>

      <% if @recipe.ingredients.any? %>
        <ul class="ingredients">
          <% @recipe.ingredients.each do |ingredient| %>
            <li class="ingredient">
              <%= ingredient_amount(ingredient) %>
              <span class="ingredient__name"><%= ingredient.name %></span><% if ingredient.note.present? %><span class="ingredient__note">, <%= ingredient.note %></span><% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="muted">No ingredients yet. <%= link_to "Add some", edit_recipe_path(@recipe) %>.</p>
      <% end %>
    </section>

    <section class="recipe__method" aria-labelledby="method-heading">
      <h2 id="method-heading">Method</h2>
      <% if @recipe.steps.any? %>
        <ol class="steps">
          <% @recipe.steps.each do |step| %>
            <li class="step"><%= step.body %></li>
          <% end %>
        </ol>
      <% else %>
        <p class="muted">No steps yet.</p>
      <% end %>
    </section>
  </div>
</article>
